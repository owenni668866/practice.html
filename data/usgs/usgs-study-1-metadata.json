                    function __sb_login(){
                        var u = location.href;
                        if (u.indexOf("access_token") >= 0) return false;
                        if (u.indexOf("#") >=0){
                            u = u.substring(0,u.indexOf("#"));
                        }
                        if (u.indexOf("?") < 0) {
                            u = u + "?access_token=";
                        }
                        else {
                            u = u + "&access_token=";
                        }
                        location.href = u;
                    }
            </script><a href="#" onclick="__sb_login()"><i class="glyphicon glyphicon-log-in" aria-hidden="true"></i> Log in</a></li>
    


